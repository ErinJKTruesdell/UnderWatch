--- !u!1001 &5857735335877114481
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 5140518586754131107}
    m_Modifications:
    - target: {fileID: 1881534070420041712, guid: b57e20b9f2df91e42a4c142e53793094, type: 3}
      propertyPath: day
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1881534070420041712, guid: b57e20b9f2df91e42a4c142e53793094, type: 3}
      propertyPath: desc
      value: "We\u2019re excited to have you join a vibrant community that thrives
        on <b>self-expression</b>, <b>friendly competition</b>, and <b>meaningful
        moments</b>. Whether you're here to share your world, level up your social
        game, or discover what inspires others, SnapGram is your new digital home.\n\nAs
        you explore, you\u2019ll <b>earn points</b>, <b>unlock badges</b>, and <b>rise
        through the ranks</b> \u2014 not just for likes and comments, but for how
        you support others, spark conversations, and engage with the community.\n\nBut
        SnapGram is more than a game. It\u2019s a place to <b>be real</b>, <b>stay
        safe</b>, and <b>grow</b>. You control your experience \u2014 your data,
        your feed, your voice.\n\nSo start <b>snapping</b>, <b>tagging</b>, and <b>climbing
        the leaderboard</b>. Join challenges, find your crew, and let your creativity
        shine.\n\n<size=110%><color=#B4114B><b>Welcome to the SnapGram family \u2014
        let the game begin!</b></color></size>\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1881534070420041712, guid: b57e20b9f2df91e42a4c142e53793094, type: 3}
      propertyPath: title
      value: Welcome to SnapGram!
      objectReference: {fileID: 0}
    - target: {fileID: 1881534070420041712, guid: b57e20b9f2df91e42a4c142e53793094, type: 3}
      propertyPath: subtitle
      value: So excited to have you!
      objectReference: {fileID: 0}
